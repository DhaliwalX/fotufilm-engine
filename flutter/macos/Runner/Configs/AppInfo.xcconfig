// The app's name and identity. A source build is an app of its own, with no release feed; an
// official build (build.sh with FOTUFILM_SOURCE_BUILD=0) writes Identity.xcconfig to take the Mac
// app's identity and feed, so it replaces the installed app in place, as cef/build.sh does.
PRODUCT_NAME = Fotufilm
FOTUFILM_BUNDLE_ID = com.muastudio.fotufilm.source
FOTUFILM_UPDATE_FEED =
FOTUFILM_RELEASE_LIST =
#include? "Identity.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER = $(FOTUFILM_BUNDLE_ID)

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 MUAStudio Inc. All rights reserved.
