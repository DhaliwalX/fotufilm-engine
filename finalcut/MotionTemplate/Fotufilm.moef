            <parameter name="Halo Colour" id="17" flags="12901679120" default="0" value="0"/>
            <parameter name="Lens Flare" id="18" flags="12901679120" default="0" value="0"/>
            <parameter name="DIR Couplers" id="19" flags="12901679120" default="1" value="1"/>
            <parameter name="Grain Seed" id="21" flags="12901679121"
                       default="1179208781" value="1179208781"/>
          </parameter>

          <parameter name="The Lab" id="35" flags="8594198560">
            <foldFlags>15</foldFlags>
            <parameter name="Push / Pull" id="22" flags="12901679120" default="0" value="0"/>
            <parameter name="Bleach Bypass" id="23" flags="12901679120"
                       default="0" value="0"/>
            <parameter name="Expired" id="24" flags="12901679120" default="0" value="0"/>
