            <parameter name="Source Media" id="325" flags="8590000146"/>
          </parameter>
          <parameter name="Page Number" id="301" flags="8589934610" default="1" value="1"/>
          <parameter name="Retime Value" id="304" flags="8590066066" default="1" value="1"/>
          <parameter name="Retime Value Cache" id="319" flags="8590065810"
                     default="1" value="1"/>
        </parameter>
        <parameter name="Object" id="2" flags="8589938704">
          <parameter name="Drop Zone" id="311" flags="8589934738" default="0" value="1"/>
          <parameter name="Type" id="321" flags="8590000146" default="0" value="3"/>
          <parameter name="Width" id="313" flags="8589934610" default="1" value="1920"/>
          <parameter name="Height" id="314" flags="8589934610" default="1" value="1080"/>
        </parameter>

        <!-- Dynamic parameters must stay disabled here. With a static Motion channel tree, setting
             this to 1 makes Final Cut's Ozone serializer dereference a missing folder. -->
        <filter name="Fotufilm" id="9001001" factoryID="6"
                pluginUUID="C4D9D06C-A2A7-48B4-830B-9AE81B970140"
                pluginVersion="1" pluginName="FotufilmEffect" pluginDynamicParams="0">
          <timing in="0 1 1 0" out="1197196 120000 1 0" offset="0 1 1 0"/>
          <baseFlags>8589934608</baseFlags>

          <!-- The read-only status line, outside every group because it is created before the
               first startParameterSubGroup and belongs at the top of the inspector. It is a
               string channel like the hidden identities, but unlike them it is published: it is
               the one place the plugin can say why something it was asked for is not happening. -->
          <parameter name="Status" id="37" flags="12901679104" default="" value=""/>

          <!-- Parameter subgroups are channel folders in Motion's serializer. Their ids and
               nesting must match startParameterSubGroup calls in the FxPlug. -->
          <parameter name="Pipeline" id="30" flags="8594198560">
            <foldFlags>15</foldFlags>
            <parameter name="Stage" id="1" flags="12901744656" default="0" value="0"/>
            <parameter name="Emulsion Diffusion" id="40" flags="12901679104"
                       default="1" value="1"/>
            <parameter name="Halation Stage" id="41" flags="12901679104"
                       default="1" value="1"/>
            <parameter name="Adjacency" id="42" flags="12901679104" default="1" value="1"/>
            <parameter name="Grain Stage" id="43" flags="12901679104" default="1" value="1"/>
            <parameter name="Enlarger" id="44" flags="12901679104" default="1" value="1"/>
          </parameter>

          <parameter name="Film" id="31" flags="8594198560">
            <foldFlags>4</foldFlags>
            <parameter name="Stock" id="2" flags="12901744656" default="0" value="0"/>
            <parameter name="Format" id="3" flags="12901744656" default="9" value="9"/>
            <parameter name="Timeline Color Space" id="5" flags="12901744656"
                       default="7" value="7"/>
          </parameter>

          <parameter name="Output" id="36" flags="8594198560">
            <foldFlags>4</foldFlags>
            <parameter name="Output Medium" id="4" flags="12901744656"
                       default="9" value="9"/>
            <parameter name="Viewing Illuminant" id="25" flags="12901744656"
                       default="0" value="0"/>
            <parameter name="Channel Contrast Match" id="20" flags="12901679120"
                       default="0.05" value="0.05"/>
            <parameter name="Negative Viewing" id="80" flags="12901744656"
                       default="0" value="0"/>
          </parameter>

          <!-- Hidden string channels persist durable menu identities. They are intentionally not
               published, but must exist in the static channel tree for saved projects. -->
          <parameter name="id" id="26" flags="12901679104" default="" value=""/>
          <parameter name="id" id="27" flags="12901679104" default="" value=""/>
          <parameter name="id" id="28" flags="12901679104" default="" value=""/>
          <parameter name="id" id="29" flags="12901679104" default="" value=""/>

          <parameter name="Exposure" id="32" flags="8594198560">
            <foldFlags>4</foldFlags>
            <parameter name="Exposure" id="6" flags="12901679120" default="0" value="0"/>
            <parameter name="Temperature" id="7" flags="12901679120"
                       default="6504" value="6504"/>
            <parameter name="Tint" id="8" flags="12901679120" default="0" value="0"/>
          </parameter>

          <!-- The lens, in the order the light meets it. The grade menu opens on 1/4, which is
               index 1 of DiffusionFilter.Grade, and the metering menu on entry 1, which is
               through-the-lens: both are the engine's own defaults rather than the first entry
               of a list. -->
          <parameter name="Lens" id="72" flags="8594198560">
            <foldFlags>15</foldFlags>
            <parameter name="Filter 1" id="73" flags="12901744656" default="0" value="0"/>
            <parameter name="Filter 2" id="74" flags="12901744656" default="0" value="0"/>
            <parameter name="Filter 3" id="75" flags="12901744656" default="0" value="0"/>
            <parameter name="Metering" id="76" flags="12901744656" default="1" value="1"/>
            <parameter name="Diffusion" id="77" flags="12901744656" default="0" value="0"/>
            <parameter name="Diffusion Grade" id="78" flags="12901744656"
                       default="1" value="1"/>
            <parameter name="Focal Length" id="79" flags="12901679120" default="0" value="0"/>
          </parameter>

          <!-- The durable identity of the four catalogue menus above, as 26...29 are for the
               menus at the top of the panel. Not published; serialized so a saved project keeps
               the filter it was graded through when the drawer is renumbered under it. -->
          <parameter name="id" id="81" flags="12901679104" default="" value=""/>
          <parameter name="id" id="82" flags="12901679104" default="" value=""/>
          <parameter name="id" id="83" flags="12901679104" default="" value=""/>
          <parameter name="id" id="84" flags="12901679104" default="" value=""/>

          <parameter name="Tone" id="33" flags="8594198560">
            <foldFlags>4</foldFlags>
            <parameter name="Highlights" id="9" flags="12901679120" default="0" value="0"/>
            <parameter name="Shadows" id="10" flags="12901679120" default="0" value="0"/>
            <parameter name="Regional Tone Mask" id="11" flags="12901679104"
                       default="1" value="1"/>
            <parameter name="Saturation" id="12" flags="12901679120" default="1" value="1"/>
            <parameter name="Vibrance" id="13" flags="12901679120" default="0" value="0"/>
          </parameter>

          <parameter name="Film Response" id="34" flags="8594198560">
            <foldFlags>4</foldFlags>
            <parameter name="Grain" id="14" flags="12901679120" default="1" value="1"/>
            <parameter name="Halation" id="15" flags="12901679120" default="1" value="1"/>
