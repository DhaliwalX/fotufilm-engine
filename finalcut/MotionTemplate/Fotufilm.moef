      <target object="9001001" channel="./72/77" name="Diffusion"/>
      <target object="9001001" channel="./72/78" name="Diffusion Grade"/>
      <target object="9001001" channel="./72/79" name="Focal Length"/>
      <target object="9001001" channel="./33/9" name="Highlights"/>
      <target object="9001001" channel="./33/10" name="Shadows"/>
      <target object="9001001" channel="./33/11" name="Regional Tone Mask"/>
      <target object="9001001" channel="./33/12" name="Saturation"/>
      <target object="9001001" channel="./33/13" name="Vibrance"/>
      <target object="9001001" channel="./34/14" name="Grain"/>
      <target object="9001001" channel="./34/15" name="Halation"/>
      <target object="9001001" channel="./34/16" name="Estimated Halation Shape"/>
      <target object="9001001" channel="./34/17" name="Halo Colour"/>
      <target object="9001001" channel="./34/18" name="Lens Flare"/>
      <target object="9001001" channel="./34/19" name="DIR Couplers"/>
