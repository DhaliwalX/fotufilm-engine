      <parameterColorSpaceID>3</parameterColorSpaceID>
      <savePreviewMovie>0</savePreviewMovie>
      <Object3DEnvironments>100</Object3DEnvironments>
      <DRTSupport>1</DRTSupport>
    </sceneSettings>

    <!-- Final Cut only shows controls explicitly published by the Motion template. The FxPlug
         parameter ids are the persisted ABI declared in FotufilmEffect.h. -->
    <publishSettings>
      <version>2</version>
      <target object="9001001" channel="./37" name="Status"/>
      <target object="9001001" channel="./30/1" name="Stage"/>
      <target object="9001001" channel="./30/40" name="Emulsion Diffusion"/>
      <target object="9001001" channel="./30/41" name="Halation Stage"/>
      <target object="9001001" channel="./30/42" name="Adjacency"/>
      <target object="9001001" channel="./30/43" name="Grain Stage"/>
      <target object="9001001" channel="./30/44" name="Enlarger"/>
      <target object="9001001" channel="./31/2" name="Stock"/>
      <target object="9001001" channel="./31/3" name="Format"/>
      <target object="9001001" channel="./31/5" name="Timeline Color Space"/>
      <target object="9001001" channel="./36/4" name="Output Medium"/>
