         // Determine the arguments that must be passed into the halide function
         vector<DeviceArgument> closure_args = c.arguments();
+
+        // Vulkan forbids OpTypeBool in a uniform block. Give each scalar predicate a
+        // UInt32 ABI on both sides of the launch, restoring Bool inside the device IR.
+        // This also avoids relying on a driver's interpretation of one-byte bools.
+        Stmt device_loop = loop;
+        map<string, string> vulkan_bool_arguments;
+        if (loop->device_api == DeviceAPI::Vulkan) {
+            for (DeviceArgument &arg : closure_args) {
+                if (!arg.is_buffer && arg.type.is_bool()) {
+                    const string original_name = arg.name;
+                    arg.name = unique_name(original_name + ".vulkan_bool");
+                    arg.type = UInt(32);
+                    vulkan_bool_arguments[arg.name] = original_name;
+                    device_loop = substitute(original_name,
+                        Variable::make(UInt(32), arg.name) != make_zero(UInt(32)), device_loop);
+                }
+            }
+        }

         // Sort the args by the size of the underlying type. This is
         // helpful for avoiding struct-packing ambiguities in metal,
@@ -175,7 +194,7 @@
