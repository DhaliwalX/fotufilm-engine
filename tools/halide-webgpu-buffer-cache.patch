+// Storage buffers are reused only after their last command has been submitted.
+// Queue ordering protects prior readers when a later frame writes the buffer.
+// All access is protected by WgpuContext's context lock.
+struct CachedStorageBuffer {
+    WGPUDevice device;
+    WGPUBuffer buffer;
+    uint64_t size;
+};
+WEAK CachedStorageBuffer cached_storage[64] = {};
+WEAK uint64_t cached_storage_bytes = 0;
+WEAK uint32_t next_storage_slot = 0;
+constexpr uint64_t storage_cache_limit = 128 * 1024 * 1024;
+
+void discard_storage_slot(uint32_t slot) {
+    CachedStorageBuffer &entry = cached_storage[slot];
+    if (!entry.buffer) return;
+    cached_storage_bytes -= entry.size;
+    wgpuBufferDestroy(entry.buffer);
+    wgpuBufferRelease(entry.buffer);
+    entry = {};
+}
+
+WGPUBuffer take_cached_storage(WGPUDevice device, uint64_t size) {
+    for (auto &entry : cached_storage) {
+        if (entry.buffer && entry.device == device && entry.size == size) {
+            WGPUBuffer buffer = entry.buffer;
+            cached_storage_bytes -= entry.size;
+            entry = {};
+            return buffer;
+        }
+    }
+    return nullptr;
+}
+
+void retain_storage(WGPUDevice device, WGPUBuffer buffer) {
+    const uint64_t size = wgpuBufferGetSize(buffer);
+    if (size > storage_cache_limit) {
+        wgpuBufferDestroy(buffer);
+        wgpuBufferRelease(buffer);
+        return;
+    }
+    // Evict oldest entries until both the fixed entry count and byte budget fit.
+    discard_storage_slot(next_storage_slot);
+    while (cached_storage_bytes + size > storage_cache_limit) {
+        next_storage_slot = (next_storage_slot + 1) % 64;
+        discard_storage_slot(next_storage_slot);
+    }
+    cached_storage[next_storage_slot] = {device, buffer, size};
+    cached_storage_bytes += size;
+    next_storage_slot = (next_storage_slot + 1) % 64;
+}
+
+void release_cached_storage(WGPUDevice device) {
+    for (uint32_t slot = 0; slot < 64; ++slot) {
+        if (cached_storage[slot].device == device) discard_storage_slot(slot);
+    }
+}
