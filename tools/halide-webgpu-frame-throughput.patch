+WGPUBuffer create_staging(WGPUDevice device, uint64_t size, WGPUBufferUsage usage,
+                          bool mapped) {
+    WGPUBufferDescriptor desc = WGPU_BUFFER_DESCRIPTOR_INIT;
+    desc.usage = usage;
+    desc.size = size;
+    desc.mappedAtCreation = mapped;
