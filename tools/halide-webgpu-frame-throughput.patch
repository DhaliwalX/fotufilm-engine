+// Staging buffers for host transfers, kept between frames.
+//
+// Uploads go through a mapped MapWrite buffer and a buffer copy rather than
+// wgpuQueueWriteBuffer. Measured in Chrome on an Apple GPU, writeBuffer of a
+// 23 MB frame took 4.4 ms to reach the GPU and a mapped staging buffer 1.3 ms:
+// the browser copies queue writes through its own transfer memory. Each upload
+// buffer is mapped again as soon as its copy is submitted, so by the next frame
+// the map has normally resolved and the upload does not wait.
+//
+// Read backs use one staging buffer the size of the copy, so a frame larger
+// than the context's 4 MB staging buffer is read in one copy and one map
+// rather than one per 4 MB. Protected by the context lock.
+struct StagingBuffer {
+    WGPUBuffer buffer;
+    uint64_t size;
+    WGPUFuture future;
+    bool pending;
+    volatile WGPUMapAsyncStatus status;
+};
+constexpr uint32_t kUploadStagingCount = 16;
+// Large uploads go in chunks with a staging buffer each, so the browser's GPU
+// process copies one chunk out of shared memory while the next is written in.
+constexpr uint64_t kUploadChunk = 4 * 1024 * 1024;
+constexpr uint32_t kReadbackStagingCount = 4;
+constexpr uint64_t kStagedUploadMinimum = 256 * 1024;
+WEAK StagingBuffer upload_staging[kUploadStagingCount] = {};
+WEAK StagingBuffer readback_staging[kReadbackStagingCount] = {};
+WEAK uint32_t next_upload_staging = 0;
+WEAK uint32_t next_readback_staging = 0;
