+// A cache of compute pipelines: one per shader module, entry point and set of
+// override constants.
+//
+// wgpuDeviceCreateComputePipelineAsync compiles the entry point down to the
+// adapter's own shader language, and that is where the time goes. Measured in
+// Chrome on an Apple GPU, a frame of 64 dispatches spent about 160 ms per
+// dispatch creating a pipeline it had created for the previous frame and
+// released as soon as the dispatch was encoded. Holding the pipeline makes
+// every dispatch after the first a lookup.
+//
+// The workgroup size and workgroup memory size are pipeline-overridable
+// constants, so they are part of the key. The list is only touched while the
+// context lock is held, which every caller already does.
+struct WgpuCachedPipeline {
+    WGPUDevice device;
+    WGPUShaderModule module;
+    char *entry_name;
+    int threads[3];
+    int workgroup_mem_bytes;
+    WGPUComputePipeline pipeline;
+    WgpuCachedPipeline *next;
+};
+WEAK WgpuCachedPipeline *pipeline_cache = nullptr;
+
+namespace {
+
+WGPUComputePipeline lookup_cached_pipeline(WGPUDevice device,
+                                           WGPUShaderModule module,
+                                           const char *entry_name,
+                                           int threadsX, int threadsY, int threadsZ,
+                                           int workgroup_mem_bytes) {
+    for (WgpuCachedPipeline *entry = pipeline_cache; entry != nullptr; entry = entry->next) {
+        if (entry->device == device && entry->module == module &&
+            entry->threads[0] == threadsX && entry->threads[1] == threadsY &&
+            entry->threads[2] == threadsZ &&
+            entry->workgroup_mem_bytes == workgroup_mem_bytes &&
+            strcmp(entry->entry_name, entry_name) == 0) {
+            return entry->pipeline;
+        }
+    }
+    return nullptr;
+}
+
+// Takes ownership of the pipeline when it returns true. When it cannot
+// allocate the entry, the pipeline is not cached and the caller releases it
+// after the dispatch as before.
+bool cache_pipeline(WGPUDevice device, WGPUShaderModule module,
+                    const char *entry_name,
+                    int threadsX, int threadsY, int threadsZ,
+                    int workgroup_mem_bytes,
+                    WGPUComputePipeline pipeline) {
+    WgpuCachedPipeline *entry = (WgpuCachedPipeline *)malloc(sizeof(WgpuCachedPipeline));
+    if (entry == nullptr) {
+        return false;
+    }
+    size_t name_size = strlen(entry_name) + 1;
+    entry->entry_name = (char *)malloc(name_size);
+    if (entry->entry_name == nullptr) {
+        free(entry);
+        return false;
+    }
+    memcpy(entry->entry_name, entry_name, name_size);
+    entry->device = device;
+    entry->module = module;
+    entry->threads[0] = threadsX;
+    entry->threads[1] = threadsY;
+    entry->threads[2] = threadsZ;
+    entry->workgroup_mem_bytes = workgroup_mem_bytes;
+    entry->pipeline = pipeline;
+    entry->next = pipeline_cache;
+    pipeline_cache = entry;
+    return true;
+}
+
+// Releases the pipelines cached for one device, or for every device when
+// device is nullptr. Must run before the shader modules they were built from
+// are released.
+void release_cached_pipelines(void *user_context, WGPUDevice device) {
+    WgpuCachedPipeline **link = &pipeline_cache;
+    while (*link != nullptr) {
+        WgpuCachedPipeline *entry = *link;
+        if (device == nullptr || entry->device == device) {
+            debug(user_context) << "WGPU: releasing cached pipeline "
+                                << entry->entry_name << "\n";
+            wgpuComputePipelineRelease(entry->pipeline);
+            *link = entry->next;
+            free(entry->entry_name);
+            free(entry);
+        } else {
+            link = &entry->next;
+        }
+    }
+}
+
+}  // namespace
+
 namespace {
 
 halide_error_code_t init_error_code = halide_error_code_success;
