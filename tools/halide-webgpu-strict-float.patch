+void CodeGen_WebGPU_Dev::CodeGen_WGSL::print_exact_call(Type type, const string &name, const vector<Expr> &args) {
+    vector<string> ids;
+    for (const auto &a : args) ids.push_back(print_expr(a));
+    ostringstream rhs;
+    if (type.lanes() != 1) rhs << print_type(type) << "(";
+    for (int lane = 0; lane < type.lanes(); ++lane) {
+        if (lane) rhs << ", ";
+        rhs << name << "(";
+        for (size_t i = 0; i < args.size(); ++i) {
+            if (i) rhs << ", ";
+            rhs << ids[i];
+            if (args[i].type().lanes() != 1) rhs << "[" << lane << "]";
+        }
+        rhs << ")";
+    }
+    if (type.lanes() != 1) rhs << ")";
+    print_assignment(type, rhs.str());
+}
