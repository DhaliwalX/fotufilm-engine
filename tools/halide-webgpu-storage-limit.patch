             supportedLimits.maxComputeWorkgroupSizeY;
         requestedLimits.maxComputeWorkgroupSizeZ =
             supportedLimits.maxComputeWorkgroupSizeZ;
+        requestedLimits.maxStorageBuffersPerShaderStage =
